#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import unicodedata
import urllib.request
import urllib.error

DEFAULT_MODEL = "claude-haiku-4-5-20251001"
ENV_PATH = os.path.join(os.path.dirname(os.path.realpath(__file__)), ".env")
API_URL = "https://api.anthropic.com/v1/messages"

SYSTEM_PROMPT = """You are askai, a terminal assistant. The user gives you a prompt.

Decide if the user is asking for a bash command/script (something they want to run on macOS/Linux), or asking a normal question. Use the prior conversation as context for follow-ups.

Respond using ONLY the tagged plain-text format below — no JSON, no markdown fences, no extra prose.

For a bash request, output one or more option blocks (1-3 options, best first):

@@TYPE bash
@@OPT
@@DESC <short description>
@@CMD
<bash command, one or more lines, directly runnable>
@@OPT
@@DESC <short description>
@@CMD
<bash command>

For a normal question, output:

@@TYPE answer
@@TEXT
<one concise paragraph; plain text, may include quotes and any characters>

Rules:
- Every directive line begins with @@ at column 0.
- @@CMD and @@TEXT consume every following line until the next @@ line or end of message.
- No placeholders in commands unless unavoidable.
"""

ANSI_RESET = "\033[0m"
ANSI_DIM = "\033[2m"
ANSI_BOLD = "\033[1m"
ANSI_CYAN = "\033[36m"
ANSI_GREEN = "\033[32m"
ANSI_YELLOW = "\033[33m"
ANSI_RED = "\033[31m"


def load_env():
    if not os.path.exists(ENV_PATH):
        sys.exit(f"missing {ENV_PATH} — copy .env.example to .env and fill in ANTHROPIC_API_KEY")
    env = {}
    with open(ENV_PATH) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = v.strip()
            if len(v) >= 2 and v[0] in ("'", '"') and v[-1] == v[0]:
                v = v[1:-1]
            env[k.strip()] = v
    if "ANTHROPIC_API_KEY" not in env:
        sys.exit(f"ANTHROPIC_API_KEY not found in {ENV_PATH}")
    return env


def call_claude(api_key, model, messages):
    body = json.dumps({
        "model": model,
        "max_tokens": 1024,
        "system": SYSTEM_PROMPT,
        "messages": messages,
    }).encode()
    req = urllib.request.Request(
        API_URL,
        data=body,
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        sys.exit(f"API error {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        sys.exit(f"network error: {e}")
    return data["content"][0]["text"]


def parse_response(text):
    text = text.strip()
    if not text.startswith("@@"):
        # model didn't follow format; treat the whole thing as an answer
        return {"type": "answer", "text": text}

    kind = None
    answer_lines = []
    options = []
    cur_opt = None
    mode = None  # None | "text" | "cmd"

    for line in text.splitlines():
        if line.startswith("@@"):
            rest = line[2:].strip()
            head, _, arg = rest.partition(" ")
            head = head.upper()
            arg = arg.strip()
            if head == "TYPE":
                kind = arg.lower()
                mode = None
            elif head == "OPT":
                if cur_opt is not None:
                    options.append(cur_opt)
                cur_opt = {"desc": "", "cmd": ""}
                mode = None
            elif head == "DESC":
                if cur_opt is None:
                    cur_opt = {"desc": "", "cmd": ""}
                cur_opt["desc"] = arg
                mode = None
            elif head == "CMD":
                if cur_opt is None:
                    cur_opt = {"desc": "", "cmd": ""}
                mode = "cmd"
            elif head == "TEXT":
                mode = "text"
            else:
                mode = None
        else:
            if mode == "cmd" and cur_opt is not None:
                cur_opt["cmd"] += line + "\n"
            elif mode == "text":
                answer_lines.append(line)

    if cur_opt is not None:
        options.append(cur_opt)

    if kind == "bash":
        for o in options:
            o["cmd"] = o["cmd"].rstrip("\n")
        return {"type": "bash", "options": options}
    if kind == "answer":
        return {"type": "answer", "text": "\n".join(answer_lines).strip()}
    return {"type": "answer", "text": text}


def char_width(ch):
    if unicodedata.east_asian_width(ch) in ("W", "F"):
        return 2
    if unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    return 1


def visual_wrap(text, width):
    lines = []
    buf = []
    buf_w = 0
    last_space = -1  # index in buf where we can break (after a space)
    for ch in text:
        if ch == "\n":
            lines.append("".join(buf).rstrip())
            buf, buf_w, last_space = [], 0, -1
            continue
        cw = char_width(ch)
        if buf_w + cw > width and buf:
            if last_space >= 0:
                head = "".join(buf[:last_space]).rstrip()
                tail = "".join(buf[last_space + 1:])
                lines.append(head)
                buf = list(tail)
                buf_w = sum(char_width(c) for c in buf)
                last_space = -1
            else:
                lines.append("".join(buf))
                buf, buf_w, last_space = [], 0, -1
        if ch == " " and buf_w == 0:
            continue  # skip leading spaces on a wrapped line
        if ch == " ":
            last_space = len(buf)
        buf.append(ch)
        buf_w += cw
    if buf:
        lines.append("".join(buf).rstrip())
    return lines


def render_answer(text):
    print()
    for paragraph in text.split("\n\n"):
        for line in visual_wrap(paragraph.strip(), 100):
            print(f"  {line}")
    print()


def render_bash(options):
    print()
    for i, opt in enumerate(options, 1):
        desc = opt.get("desc", "")
        cmd = opt.get("cmd", "")
        print(f"  {ANSI_BOLD}{ANSI_CYAN}[{i}]{ANSI_RESET} {ANSI_DIM}{desc}{ANSI_RESET}")
        for line in cmd.splitlines() or [""]:
            print(f"      {ANSI_GREEN}{line}{ANSI_RESET}")
        print()


def run_cmd(cmd):
    print()
    print(f"  {ANSI_DIM}$ {cmd}{ANSI_RESET}")
    print()
    rc = subprocess.call(cmd, shell=True, executable="/bin/bash")
    if rc != 0:
        print()
        print(f"  {ANSI_RED}exit {rc}{ANSI_RESET}")
    print()


def turn(api_key, model, messages, user_prompt):
    messages.append({"role": "user", "content": user_prompt})
    raw = call_claude(api_key, model, messages)
    messages.append({"role": "assistant", "content": raw})
    parsed = parse_response(raw)
    options = []
    if parsed.get("type") == "bash":
        options = parsed.get("options", []) or []
        if not options:
            render_answer("(no commands returned)")
        else:
            render_bash(options)
    else:
        render_answer(parsed.get("text", raw).strip())
    return options


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: askai '<prompt>'")
    env = load_env()
    api_key = env["ANTHROPIC_API_KEY"]
    model = env.get("ANTHROPIC_MODEL") or DEFAULT_MODEL
    messages = []
    options = turn(api_key, model, messages, " ".join(sys.argv[1:]))

    while True:
        try:
            line = input(f"  {ANSI_YELLOW}>{ANSI_RESET} ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not line:
            return
        if options and line.isdigit() and 1 <= int(line) <= len(options):
            run_cmd(options[int(line) - 1]["cmd"])
            # after running, stay in the loop but clear options so a stray
            # number on the next turn isn't reinterpreted against old options.
            options = []
            continue
        options = turn(api_key, model, messages, line)


if __name__ == "__main__":
    main()
