#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import urllib.request
import urllib.error

MODEL = "claude-haiku-4-5-20251001"
SECRETS_PATH = os.path.expanduser("~/.extra_secrets")
API_URL = "https://api.anthropic.com/v1/messages"

SYSTEM_PROMPT = """You are askai, a terminal assistant. The user gives you a prompt.

Decide if the user is asking for a bash command/script (something they want to run on macOS/Linux), or asking a normal question. Use the prior conversation as context for follow-ups.

Respond with ONLY a JSON object, no prose, no markdown fences.

If it's a bash request, respond:
{"type": "bash", "options": [{"cmd": "<one-line or multi-line bash>", "desc": "<short description>"}, ...]}
- Provide 1-3 options, ordered most-recommended first.
- Each cmd must be directly runnable in bash. No placeholders unless unavoidable.

If it's a normal question, respond:
{"type": "answer", "text": "<one concise paragraph>"}
"""

ANSI_RESET = "\033[0m"
ANSI_DIM = "\033[2m"
ANSI_BOLD = "\033[1m"
ANSI_CYAN = "\033[36m"
ANSI_GREEN = "\033[32m"
ANSI_YELLOW = "\033[33m"
ANSI_RED = "\033[31m"


def load_api_key():
    if not os.path.exists(SECRETS_PATH):
        sys.exit(f"missing {SECRETS_PATH}")
    with open(SECRETS_PATH) as f:
        for line in f:
            line = line.strip()
            if line.startswith("ANTHROPIC_API_KEY="):
                return line.split("=", 1)[1].strip()
    sys.exit("ANTHROPIC_API_KEY not found in ~/.extra_secrets")


def call_claude(api_key, messages):
    body = json.dumps({
        "model": MODEL,
        "max_tokens": 1024,
        "system": SYSTEM_PROMPT,
        "messages": messages,
    }).encode()
    req = urllib.request.Request(
        API_URL,
        data=body,
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        sys.exit(f"API error {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        sys.exit(f"network error: {e}")
    return data["content"][0]["text"]


def parse_response(text):
    text = text.strip()
    if text.startswith("```"):
        text = text.strip("`")
        if text.startswith("json"):
            text = text[4:]
        text = text.strip()
    start = text.find("{")
    end = text.rfind("}")
    if start == -1 or end == -1:
        return {"type": "answer", "text": text}
    try:
        return json.loads(text[start:end + 1])
    except json.JSONDecodeError:
        return {"type": "answer", "text": text}


def render_answer(text):
    print()
    print(f"  {text}")
    print()


def render_bash(options):
    print()
    for i, opt in enumerate(options, 1):
        desc = opt.get("desc", "")
        cmd = opt.get("cmd", "")
        print(f"  {ANSI_BOLD}{ANSI_CYAN}[{i}]{ANSI_RESET} {ANSI_DIM}{desc}{ANSI_RESET}")
        for line in cmd.splitlines() or [""]:
            print(f"      {ANSI_GREEN}{line}{ANSI_RESET}")
        print()


def run_cmd(cmd):
    print()
    print(f"  {ANSI_DIM}$ {cmd}{ANSI_RESET}")
    print()
    rc = subprocess.call(cmd, shell=True, executable="/bin/bash")
    if rc != 0:
        print()
        print(f"  {ANSI_RED}exit {rc}{ANSI_RESET}")
    print()


def turn(api_key, messages, user_prompt):
    messages.append({"role": "user", "content": user_prompt})
    raw = call_claude(api_key, messages)
    messages.append({"role": "assistant", "content": raw})
    parsed = parse_response(raw)
    options = []
    if parsed.get("type") == "bash":
        options = parsed.get("options", []) or []
        if not options:
            render_answer("(no commands returned)")
        else:
            render_bash(options)
    else:
        render_answer(parsed.get("text", raw).strip())
    return options


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: askai '<prompt>'")
    api_key = load_api_key()
    messages = []
    options = turn(api_key, messages, " ".join(sys.argv[1:]))

    while True:
        try:
            line = input(f"  {ANSI_YELLOW}>{ANSI_RESET} ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not line:
            return
        if options and line.isdigit() and 1 <= int(line) <= len(options):
            run_cmd(options[int(line) - 1]["cmd"])
            # after running, stay in the loop but clear options so a stray
            # number on the next turn isn't reinterpreted against old options.
            options = []
            continue
        options = turn(api_key, messages, line)


if __name__ == "__main__":
    main()
